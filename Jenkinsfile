pipeline {

    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {

        DOCKER_USER = "mrunalihatzade"

        BACKEND_IMAGE = "mrunalihatzade/student-task-backend"
        FRONTEND_IMAGE = "mrunalihatzade/student-task-frontend"

        SKIP_PIPELINE = "false"
    }

    stages {

        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Check Trigger") {
            steps {
                script {

                    def commitMessage = sh(
                        script: "git log -1 --pretty=%B",
                        returnStdout: true
                    ).trim()

                    echo "Latest commit message:"
                    echo commitMessage

                    if (commitMessage.contains("[skip ci]")) {

                        echo "This commit was generated by Jenkins."
                        echo "Skipping CI pipeline to prevent infinite loop."

                        env.SKIP_PIPELINE = "true"
                        currentBuild.result = "NOT_BUILT"
                    }
                }
            }
        }

        stage("Calculate Version") {

            when {
                expression {
                    env.SKIP_PIPELINE != "true"
                }
            }

            steps {

                script {

                    def currentVersion = sh(
                        script: """
                            grep -oE 'v1\\.0\\.[0-9]+' k8s/backend-deployment.yaml | head -1 || true
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Current version: ${currentVersion}"

                    if (!currentVersion) {
                        currentVersion = "v1.0.0"
                    }

                    def currentPatch = currentVersion
                        .replace("v1.0.", "")
                        .toInteger()

                    def nextPatch = currentPatch + 1

                    env.IMAGE_TAG = "v1.0.${nextPatch}"

                    echo "New image version: ${env.IMAGE_TAG}"
                }
            }
        }

        stage("Docker Login") {

            when {
                expression {
                    env.SKIP_PIPELINE != "true"
                }
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "Github-credentials",
                        usernameVariable: "DOCKER_USERNAME",
                        passwordVariable: "DOCKER_PASSWORD"
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" \
                        --password-stdin
                    '''
                }
            }
        }

        stage("Build Backend") {

            when {
                expression {
                    env.SKIP_PIPELINE != "true"
                }
            }

            steps {

                sh '''
                    echo "Building backend image..."

                    docker build \
                    -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                    ./backend
                '''
            }
        }

        stage("Build Frontend") {

            when {
                expression {
                    env.SKIP_PIPELINE != "true"
                }
            }

            steps {

                sh '''
                    echo "Building frontend image..."

                    docker build \
                    -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                    ./frontend
                '''
            }
        }

        stage("Push Images") {

            when {
                expression {
                    env.SKIP_PIPELINE != "true"
                }
            }

            steps {

                sh '''
                    echo "Pushing backend image..."

                    docker push ${BACKEND_IMAGE}:${IMAGE_TAG}

                    echo "Pushing frontend image..."

                    docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage("Update Kubernetes YAML") {

            when {
                expression {
                    env.SKIP_PIPELINE != "true"
                }
            }

            steps {

                sh '''
                    echo "Updating Kubernetes deployment YAML files..."

                    sed -i -E \
                    "s|^([[:space:]]*image:[[:space:]]*${BACKEND_IMAGE})(:[^[:space:]]+)?([[:space:]]*)$|\\1:${IMAGE_TAG}\\3|" \
                    k8s/backend-deployment.yaml

                    sed -i -E \
                    "s|^([[:space:]]*image:[[:space:]]*${FRONTEND_IMAGE})(:[^[:space:]]+)?([[:space:]]*)$|\\1:${IMAGE_TAG}\\3|" \
                    k8s/frontend-deployment.yaml

                    echo ""
                    echo "Backend image:"
                    grep "image:" k8s/backend-deployment.yaml

                    echo ""
                    echo "Frontend image:"
                    grep "image:" k8s/frontend-deployment.yaml
                '''
            }
        }

        stage("Commit and Push YAML") {

            when {
                expression {
                    env.SKIP_PIPELINE != "true"
                }
            }

            steps {

                withCredentials([
                    gitUsernamePassword(
                        credentialsId: "github-push-cred",
                        gitToolName: "Default"
                    )
                ]) {

                    sh '''
                        git config user.name "jenkins-bot"
                        git config user.email "jenkins-bot@users.noreply.github.com"

                        git add k8s/backend-deployment.yaml
                        git add k8s/frontend-deployment.yaml

                        if git diff --cached --quiet; then
                            echo "No Kubernetes YAML changes detected."
                        else
                            git commit -m "ci: update image version to ${IMAGE_TAG} [skip ci]"

                            git push origin HEAD:main
                        fi
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "CI pipeline completed successfully!"
        }

        failure {
            echo "Pipeline failed!"
        }

        always {
            sh '''
                docker logout || true
            '''
        }
    }
}